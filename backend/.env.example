# AI Provider: groq | openai | gemini
AI_PROVIDER=groq

# Model (leave blank for default)
# Groq defaults: llama3-8b-8192
# OpenAI defaults: gpt-4o-mini
# Gemini defaults: gemini-1.5-flash
AI_MODEL=

# API Keys (only the one matching AI_PROVIDER is needed)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server config
PORT=5000
DEBUG=false
